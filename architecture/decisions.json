{
  "version": 1,
  "decisions": [
    {
      "id": "DEC-CORE-BOUNDARY",
      "title": "Keep the core product boundary independent of runtime adapters",
      "status": "accepted",
      "rationale": "The core workspace owns domain contracts while runtime adapters own process and I/O concerns.",
      "scope": "core/ and runtime/",
      "alternatives": [
        "Place process orchestration in core",
        "Share runtime state through teaching implementations"
      ],
      "prerequisites": [
