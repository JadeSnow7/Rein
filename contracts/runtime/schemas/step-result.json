{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StepResult",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "Transition"
      ],
      "properties": {
        "Transition": {
          "type": "object",
          "required": [
            "events",
            "expected_revision",
            "next_revision",
            "session"
          ],
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DomainEvent"
              }
            },
            "expected_revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "next_intent": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Intent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "next_revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "session": {
              "$ref": "#/definitions/HarnessSession"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "Duplicate"
      ],
      "properties": {
        "Duplicate": {
          "type": "object",
          "required": [
            "observation_id",
            "revision"
          ],
          "properties": {
            "observation_id": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "Rejected"
      ],
      "properties": {
        "Rejected": {
          "type": "object",
          "required": [
            "code",
            "expected_revision"
          ],
          "properties": {
            "code": {
              "$ref": "#/definitions/RejectCode"
            },
            "expected_revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "ActiveIntent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Model",
            "Verify"
          ]
        },
        {
          "type": "object",
          "required": [
            "Tool"
          ],
          "properties": {
            "Tool": {
              "type": "object",
              "required": [
                "args_ref",
                "call_id",
                "name"
              ],
              "properties": {
                "args_ref": {
                  "$ref": "#/definitions/ArtifactRef"
                },
                "call_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "required": [
        "hash",
        "len"
      ],
      "properties": {
        "hash": {
          "type": "string"
        },
        "len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "DomainEvent": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Cancelled",
            "ToolBudgetExhausted"
          ]
        },
        {
          "type": "object",
          "required": [
            "ObservationAccepted"
          ],
          "properties": {
            "ObservationAccepted": {
              "type": "object",
              "required": [
                "observation_id",
                "revision"
              ],
              "properties": {
                "observation_id": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "EffectScheduled"
          ],
          "properties": {
            "EffectScheduled": {
              "type": "object",
              "required": [
                "effect_id"
              ],
              "properties": {
                "effect_id": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "HarnessSession": {
      "type": "object",
      "required": [
        "attempt_id",
        "completed_effects",
        "history",
        "revision",
        "run_id",
        "session_id",
        "status",
        "tool_budget",
        "tool_result_refs",
        "verification_plan_ref"
      ],
      "properties": {
        "active_effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_intent": {
          "anyOf": [
            {
              "$ref": "#/definitions/ActiveIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "type": "string"
        },
        "completed_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_ref": {
          "anyOf": [
            {
              "$ref": "#/definitions/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/SessionStatus"
        },
        "tool_budget": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tool_result_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactRef"
          }
        },
        "verification_plan_ref": {
          "$ref": "#/definitions/ArtifactRef"
        }
      }
    },
    "Intent": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "CallModel"
          ],
          "properties": {
            "CallModel": {
              "type": "object",
              "required": [
                "effect_id"
              ],
              "properties": {
                "effect_id": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ExecuteTool"
          ],
          "properties": {
            "ExecuteTool": {
              "type": "object",
              "required": [
                "call",
                "effect_id"
              ],
              "properties": {
                "call": {
                  "$ref": "#/definitions/ToolCall"
                },
                "effect_id": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Verify"
          ],
          "properties": {
            "Verify": {
              "type": "object",
              "required": [
                "effect_id",
                "final_ref",
                "plan_ref"
              ],
              "properties": {
                "effect_id": {
                  "type": "string"
                },
                "final_ref": {
                  "$ref": "#/definitions/ArtifactRef"
                },
                "plan_ref": {
                  "$ref": "#/definitions/ArtifactRef"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RejectCode": {
      "type": "string",
      "enum": [
        "SessionMismatch",
        "RunMismatch",
        "AttemptMismatch",
        "RevisionMismatch",
        "InvalidEffect",
        "Terminal",
        "InvalidSequence",
        "BudgetExhausted"
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "Running",
        "Cancelled",
        "Completed",
        "Accepted",
        "OutcomeUnknown"
      ]
    },
    "ToolCall": {
      "type": "object",
      "required": [
        "args_ref",
        "call_id",
        "name"
      ],
      "properties": {
        "args_ref": {
          "$ref": "#/definitions/ArtifactRef"
        },
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}